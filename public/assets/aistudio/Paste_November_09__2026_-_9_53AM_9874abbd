  resumeLabel: string;
  onResume: () => void;
  onOpen: (courseId: string, stepId: string) => void;
  onSelectCourse: (id: string) => void;
  onTools: () => void;
}

function Ring({ value }: { value: number }) {
  const r = 15, c = 2 * Math.PI * r;
  return (
    <svg viewBox="0 0 36 36" className="h-10 w-10 shrink-0 -rotate-90">
      <circle cx="18" cy="18" r={r} fill="none" strokeWidth="3.5" className="stroke-dot-idle" />
      <circle cx="18" cy="18" r={r} fill="none" strokeWidth="3.5" strokeDasharray={c} strokeDashoffset={c * (1 - value / 100)} strokeLinecap="round" className={value === 100 ? "stroke-success" : "stroke-primary"} />
      <text x="18" y="18" transform="rotate(90 18 18)" textAnchor="middle" dominantBaseline="central" className="fill-foreground font-mono text-[9px]">{value}</text>
    </svg>
  );
}

export default function Home(p: Props) {
  return (
    <main className="mx-auto max-w-3xl px-4 pb-16 pt-5">
      <button type="button" onClick={p.onResume} className="flex min-h-16 w-full items-center justify-between rounded-xl bg-primary px-5 py-3 text-left text-primary-foreground">
        <span>
          <span className="block text-xs opacity-70">Продолжить</span>
          <span className="block font-semibold">{p.resumeLabel}</span>
        </span>
        <span className="text-xl">→</span>
      </button>

      <div className="no-scrollbar -mx-4 mt-5 flex gap-2 overflow-x-auto px-4">
        {p.courses.map((c) => {
          const steps = c.modules.flatMap((m) => m.lessons.flatMap((l) => l.steps));
          const done = p.store[c.id]?.completedSteps.length ?? 0;
          const active = c.id === p.course.id;
          return (
            <button key={c.id} type="button" onClick={() => p.onSelectCourse(c.id)} className={`h-12 shrink-0 rounded-lg border px-3 text-sm ${active ? "border-primary bg-primary text-primary-foreground" : "bg-card"}`}>
              {c.title.split(":")[0]} <span className="ml-1 font-mono text-xs opacity-70">{percent(done, steps.length)}%</span>
            </button>
          );
        })}
      </div>

      <h2 className="mt-5 text-lg font-bold">{p.course.title}</h2>
      <p className="mt-1 text-sm text-muted-foreground">{p.course.description}</p>

      {p.course.modules.map((m) => (
        <section key={m.id} className="mt-6">
          <h3 className="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">{m.title}</h3>
          <div className="grid gap-2 sm:grid-cols-2">
            {m.lessons.map((l) => {
              const sts = l.steps.map((s) => getStepStatus(s, p.progress));
              const done = sts.filter((s) => s !== "idle").length;
              const wrong = sts.filter((s) => s === "wrong").length;
              const first = l.steps.find((s, i) => sts[i] === "idle") ?? l.steps[0];
              return (
                <button key={l.id} type="button" onClick={() => first && p.onOpen(p.course.id, first.id)} className="flex min-h-16 items-center gap-3 rounded-lg border bg-card p-3 text-left hover:border-foreground/40">
                  <Ring l.steps.length)} value="{percent(done,"/>
                  <span className="min-w-0 flex-1">
                    <span className="block text-sm font-medium leading-snug">{l.title}</span>
                    <span className="mt-0.5 block font-mono text-xs text-muted-foreground">
                      {done}/{l.steps.length}{wrong > 0 && <span className="text-destructive"> · ✕{wrong}</span>}
                    </span>
                  </span>
                </button>
              );
            })}
          </div>
        </section>
      ))}

      <section className="mt-8">
        <h3 className="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Работа над ошибками · {p.mistakes.length}</h3>
        {p.mistakes.length === 0 ? (
          <p className="rounded-lg border border-dashed p-4 text-sm text-muted-foreground">Ошибок нет.</p>
        ) : (
          <div className="divide-y rounded-lg border bg-card">
            {p.mistakes.map((e) => (
              <button key={e.step.id} type="button" onClick={() => p.onOpen(e.courseId, e.step.id)} className="flex min-h-12 w-full items-center gap-3 px-3 py-2 text-left text-sm hover:bg-muted">
                <span className="h-2.5 w-2.5 shrink-0 rounded-full bg-destructive" />
                <span className="min-w-0 flex-1 truncate">{e.step.title}</span>
                <span className="shrink-0 text-xs text-muted-foreground">{e.courseTitle.split(":")[0]}</span>
              </button>
            ))}
          </div>
        )}
      </section>

      <button type="button" onClick={p.onTools} className="mt-8 h-12 w-full rounded-lg border bg-card text-sm font-medium">
        Калькуляторы и палеошкала →
      </button>
    </main>
  );
}

