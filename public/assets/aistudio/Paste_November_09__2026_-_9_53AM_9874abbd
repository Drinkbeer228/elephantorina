import { useState, useEffect, useCallback, useMemo } from "react";
import confetti from "canvas-confetti";
import TopBar from "./elephant/components/TopBar";
import Home from "./elephant/components/Home";
import Tools from "./elephant/components/Tools";
import { Theory, Quiz, Scenario, Flashcards } from "./elephant/components/steps";
import { COURSES_DATA } from "./data/coursesData";
import type { UserProgress } from "./types/course";
import { getLessonContext } from "./utils/courseUtils";
import { collectMistakes, stepsOf } from "./elephant/progress";

const STORAGE_KEY = "elephantology-edu-progress";
const COURSE_KEY = "elephantology-current-course";
const MODE_KEY = "elephantology-exam-mode";

type ProgressStore = Record<string, UserProgress | undefined>;
type View = "HOME" | "STEP" | "TOOLS";

const FIRST_COURSE = COURSES_DATA[0]!;

function loadProgress(): ProgressStore {
  try {
    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    if (parsed && typeof parsed === "object") return parsed;
  } catch (e) {
    console.error("Failed to load progress:", e);
  }
  return {};
}

function createDefaultProgress(courseId: string, currentStepId = ""): UserProgress {
  const now = new Date().toISOString();
  return { courseId, completedSteps: [], currentStepId, score: 0, bookmarks: [], quizAnswers: {}, scenarioAnswers: {}, startedAt: now, lastActivity: now };
}

export default function App() {
  const [store, setStore] = useState<ProgressStore>(loadProgress);
  const [courseId, setCourseId] = useState<string>(() => localStorage.getItem(COURSE_KEY) || FIRST_COURSE.id);
  const [exam, setExam] = useState(() => localStorage.getItem(MODE_KEY) === "1");
  const [view, setView] = useState<View>("HOME");
  const [pending, setPending] = useState<number | null>(null);

  const course = COURSES_DATA.find((c) => c.id === courseId) ?? FIRST_COURSE;
  const steps = useMemo(() => stepsOf(course), [course]);

  const progress: UserProgress = useMemo(() => {
    const ex = store[course.id];
    const fallback = steps[0]?.id ?? "";
    if (!ex) return createDefaultProgress(course.id, fallback);
    return {
      ...createDefaultProgress(course.id),
      ...ex,
      completedSteps: Array.isArray(ex.completedSteps) ? ex.completedSteps : [],
      bookmarks: Array.isArray(ex.bookmarks) ? ex.bookmarks : [],
      quizAnswers: ex.quizAnswers || {},
      scenarioAnswers: ex.scenarioAnswers || {},
      currentStepId: steps.some((s) => s.id === ex.currentStepId) ? ex.currentStepId : fallback,
    };
  }, [store, course.id, steps]);

  useEffect(() => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(store)); } catch { /* quota */ } }, [store]);
  useEffect(() => { try { localStorage.setItem(COURSE_KEY, courseId); } catch { /* quota */ } }, [courseId]);
  useEffect(() => { try { localStorage.setItem(MODE_KEY, exam ? "1" : "0"); } catch { /* quota */ } }, [exam]);

  const idx = Math.max(0, steps.findIndex((s) => s.id === progress.currentStepId));
  const step = steps[idx]!;
  const ctx = getLessonContext(course, step.id);
  const mistakes = useMemo(() => collectMistakes(COURSES_DATA, store), [store]);
  const courseMistakes = mistakes.filter((m) => m.courseId === course.id).length;

  useEffect(() => setPending(null), [step.id]);

  const update = useCallback((cid: string, fn: (p: UserProgress) => UserProgress) => {
    setStore((prev) => {
      const c = COURSES_DATA.find((x) => x.id === cid) ?? FIRST_COURSE;
      const base = prev[cid] ?? createDefaultProgress(cid, stepsOf(c)[0]?.id ?? "");
      return { ...prev, [cid]: fn(base) };
    });
  }, []);

  const goTo = useCallback((id: string) => {
    update(course.id, (p) => ({ ...p, currentStepId: id, lastActivity: new Date().toISOString() }));
    setView("STEP");
    window.scrollTo({ top: 0 });
  }, [course.id, update]);

  const complete = useCallback((id: string) => {
    update(course.id, (p) =>
      p.completedSteps.includes(id) ? p : { ...p, completedSteps: [...p.completedSteps, id], score: (p.score || 0) + 10, lastActivity: new Date().toISOString() },
    );
  }, [course.id, update]);

  const answered =
    step.type === "QUIZ" ? progress.quizAnswers[step.id] !== undefined
    : step.type === "SCENARIO" ? progress.scenarioAnswers[step.id] !== undefined
    : true;
  const needsConfirm = (step.type === "QUIZ" || step.type === "SCENARIO") && !answered;
  const isLast = idx === steps.length - 1;

  const confirm = useCallback(() => {
    if (pending === null) return;
    if (step.type === "QUIZ") {
      update(course.id, (p) => ({ ...p, quizAnswers: { ...p.quizAnswers, [step.id]: pending } }));
    } else if (step.type === "SCENARIO") {
      const opt = step.options[pending];
      if (!opt) return;
      update(course.id, (p) => ({ ...p, scenarioAnswers: { ...p.scenarioAnswers, [step.id]: opt.id } }));
    }
    complete(step.id);
  }, [pending, step, course.id, update, complete]);

  const next = useCallback(() => {
    complete(step.id);
    const n = steps[idx + 1];
    if (n) goTo(n.id);
    else {
      confetti({ particleCount: 120, spread: 70, origin: { y: 0.7 } });
      setView("HOME");
    }
  }, [complete, step.id, steps, idx, goTo]);

  const prev = useCallback(() => { const p = steps[idx - 1]; if (p) goTo(p.id); }, [steps, idx, goTo]);
  const primary = needsConfirm ? confirm : next;

  useEffect(() => {
    if (view !== "STEP") return;
    const h = (e: KeyboardEvent) => {
      if (e.target instanceof HTMLElement && /INPUT|SELECT|TEXTAREA/.test(e.target.tagName)) return;
      if (e.key === "ArrowRight") next();
      else if (e.key === "ArrowLeft") prev();
      else if (e.key === "Enter") { e.preventDefault(); primary(); }
      else if (needsConfirm && /^[1-9]$/.test(e.key)) {
        const i = Number(e.key) - 1;
        const n = step.type === "QUIZ" || step.type === "SCENARIO" ? step.options.length : 0;
        if (i < n) setPending(i);
      }
    };
    window.addEventListener("keydown", h);
    return () => window.removeEventListener("keydown", h);
  }, [view, next, prev, primary, needsConfirm, step]);

  const selectCourse = (id: string, stepId?: string) => {
    setCourseId(id);
    if (stepId) {
      update(id, (p) => ({ ...p, currentStepId: stepId, lastActivity: new Date().toISOString() }));
      setView("STEP");
      window.scrollTo({ top: 0 });
    }
  };

  const primaryLabel = needsConfirm
    ? "Ответить"
    : step.type === "THEORY" && !progress.completedSteps.includes(step.id)
      ? "Прочитано — далее"
      : isLast ? "Завершить трек" : "Далее";

  return (
    <div className="min-h-screen bg-background text-foreground">
      <TopBar "STEP" 0} : ? course="{course}" courses="{COURSES_DATA}" currentStepId="{view" exam="{exam}" mistakes="{courseMistakes}" null} onToggleExam="{()" progress="{store[course.id]}" score="{progress.score" step.id steps streak="{0}" ||> setExam((v) => !v)}
        onSelectCourse={(id) => selectCourse(id)}
        onSelectStep={goTo}
        onHome={() => setView("HOME")}
      />

      {view === "HOME" && (
        <Home ${step.title}`} course="{course}" courses="{COURSES_DATA}" mistakes="{mistakes}" onResume="{()" progress="{store[course.id]}" resumeLabel="{`${ctx.cleanLessonTitle}" store="{store}" ·> setView("STEP")}
          onOpen={(cid, sid) => selectCourse(cid, sid)}
          onSelectCourse={(id) => selectCourse(id)}
          onTools={() => setView("TOOLS")}
        />
      )}

      {view === "TOOLS" && <Tools onBack="{()"> setView("HOME")} />}

      {view === "STEP" && (
        <>
          <main className="mx-auto max-w-2xl px-4 pb-32 pt-4">
            <div className="mb-4 flex items-center justify-between gap-3 text-xs text-muted-foreground">
              <button type="button" onClick={() => setView("HOME")} className="h-8 truncate text-left">← {ctx.cleanLessonTitle}</button>
              <span className="shrink-0 font-mono">{idx + 1} / {steps.length}</span>
            </div>
            {step.type === "THEORY" && <Theory step="{step}"/>}
            {step.type === "QUIZ" && http://googleusercontent.com/immersive_entry_chip/0}
            {step.type === "SCENARIO" && <Scenario answer="{progress.scenarioAnswers[step.id]}" exam="{exam}" onPick="{setPending}" pending="{pending}" step="{step}"/>}
            {step.type === "FLASHCARD" && http://googleusercontent.com/immersive_entry_chip/1}
          </main>

          <nav className="fixed inset-x-0 bottom-0 z-30 border-t bg-card pb-[env(safe-area-inset-bottom)]">
            <div className="mx-auto flex max-w-2xl gap-2 px-4 py-3">
              <button type="button" onClick={prev} disabled={idx === 0} className="h-12 w-14 shrink-0 rounded-lg border bg-background text-lg disabled:opacity-40" aria-label="Назад">←</button>
              <button
                type="button"
                onClick={primary}
                disabled={needsConfirm && pending === null}
                className="h-12 flex-1 rounded-lg bg-primary font-semibold text-primary-foreground disabled:opacity-40"
              >
                {primaryLabel} <span className="ml-1 hidden font-mono text-xs opacity-60 sm:inline">Enter</span>
              </button>
            </div>
          </nav>
        </>
      )}
    </div>
  );
}

