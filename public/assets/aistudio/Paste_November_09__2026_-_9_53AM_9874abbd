    case "code":
      return (
        <pre className="my-5 overflow-x-auto rounded-xl bg-ink p-4 text-ink-foreground font-mono text-xs leading-relaxed">
          <code>{b.content}</code>
        </pre>
      );
    case "table":
      return (
        <div className="surface my-5 overflow-x-auto rounded-xl">
          <table className="w-full border-collapse text-sm">
            <thead className="bg-muted">
              <tr>
                {b.headers.map((h, i) => (
                  <th key={i} className="border-b px-3 py-2 text-left font-semibold" dangerouslySetInnerHTML={html(h)} />
                ))}
              </tr>
            </thead>
            <tbody>
              {b.rows.map((r, ri) => (
                <tr key={ri} className="border-b last:border-0">
                  {r.map((c, ci) => (
                    <td key={ci} className="px-3 py-2 align-top tabular-nums" dangerouslySetInnerHTML={html(c)} />
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    case "callout": {
      const tone = b.variant === "clinical" ? "border-streak bg-streak-soft" : b.variant === "bio" || b.variant === "enrichment" ? "border-success bg-bio-soft" : "border-primary bg-info-soft";
      const icon = b.variant === "clinical" ? "⚠" : b.variant === "bio" || b.variant === "enrichment" ? "✦" : "ℹ";
      return (
        <div className={`my-5 rounded-xl border-l-4 px-4 py-3 ${tone}`}>
          <p className="mb-1 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground"><span aria-hidden>{icon}</span>{b.title}</p>
          {b.lines.map((l, i) => (
            <p key={i} className="my-1 leading-7" dangerouslySetInnerHTML={html(l)} />;
          ))}
        </div>
      );
    }
  }
}

export default function Reader({ text }: { text: string }) {
  const blocks = parseMarkdownBlocks(text);
  return (
    <div className="prose-reader text-[16px] text-foreground">
      {blocks.map((b, i) => (
        <Block b="{b}" key="{i}"/>
      ))}
    </div>
  );
}

export function InlineText({ text, className }: { text: string; className?: string }) {
  return <span className={className} dangerouslySetInnerHTML={html(text)} />;
}

